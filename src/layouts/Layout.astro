---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | MegaTools Hub</title>
		
		<!-- SEO Meta Tags -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		
		<!-- Canonical URL -->
		<link rel="canonical" href={Astro.url} />
	</head>
	<body class="bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-slate-50 min-h-screen flex flex-col font-sans antialiased transition-colors duration-300">
		<header class="sticky top-0 z-50 w-full border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md">
			<div class="container mx-auto px-4 h-16 flex items-center justify-between">
				<a href="/" class="flex items-center space-x-2">
					<span class="text-2xl font-bold bg-gradient-to-r from-blue-600 to-indigo-500 text-transparent bg-clip-text">MegaTools</span>
				</a>
				<nav class="hidden md:flex space-x-6">
					<a href="/" class="text-sm font-medium hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Inicio</a>
					<a href="#categorias" class="text-sm font-medium hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Categorías</a>
				</nav>
			</div>
		</header>

		<main class="flex-grow container mx-auto px-4 py-8">
			<slot />
		</main>

		<footer class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 py-12">
			<div class="container mx-auto px-4 grid grid-cols-1 md:grid-cols-4 gap-8">
				<div class="md:col-span-2">
					<h3 class="text-lg font-bold mb-4">MegaTools Hub</h3>
					<p class="text-slate-600 dark:text-slate-400 max-w-sm">
						Tu plataforma gratuita con todas las herramientas web que necesitas en un solo lugar. Rápido, seguro y sin registros.
					</p>
				</div>
				<div>
					<h4 class="font-semibold mb-4 text-slate-900 dark:text-white">Legal</h4>
					<ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
						<li><a href="#" class="hover:text-blue-600 dark:hover:text-blue-400">Política de Privacidad</a></li>
						<li><a href="#" class="hover:text-blue-600 dark:hover:text-blue-400">Términos de Servicio</a></li>
						<li><a href="#" class="hover:text-blue-600 dark:hover:text-blue-400">Cookies</a></li>
					</ul>
				</div>
				<div>
					<h4 class="font-semibold mb-4 text-slate-900 dark:text-white">Monetización</h4>
					<div class="bg-slate-100 dark:bg-slate-800 rounded flex items-center justify-center p-4 text-xs text-slate-400 border border-dashed border-slate-300 dark:border-slate-700">
						Espacio para AdSense
					</div>
				</div>
			</div>
			<div class="container mx-auto px-4 mt-8 pt-8 border-t border-slate-200 dark:border-slate-800 text-center text-sm text-slate-500">
				&copy; {new Date().getFullYear()} MegaTools Hub. Todos los derechos reservados.
			</div>
		</footer>
	</body>
</html>
