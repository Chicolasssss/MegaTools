---
import Layout from './Layout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import RelatedTools from '../components/tools/RelatedTools.astro';

export interface Props {
  title: string;
  description: string;
  category: string;
  slug: string;
}

const { title, description, category, slug } = Astro.props;

const breadcrumbItems = [
  { name: category, url: `/category/${category.toLowerCase()}` },
  { name: title }
];
---

<Layout title={title} description={description}>
  <div class="max-w-4xl mx-auto">
    <Breadcrumbs items={breadcrumbItems} />

    <AdSlot variant="top" />

    <div class="text-center mb-10">
      <h1 class="text-3xl md:text-5xl font-extrabold mb-4 tracking-tight">{title}</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">{description}</p>
    </div>

    <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl p-6 md:p-10 shadow-sm mb-12">
      <slot name="tool" />
    </div>

    <AdSlot variant="mid" />

    <article class="prose prose-gray dark:prose-invert max-w-none prose-headings:font-bold prose-a:text-blue-600 mt-12 bg-white dark:bg-gray-900 p-8 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm">
      <slot name="content" />
    </article>

    <RelatedTools currentToolId={slug} category={category} />

    <AdSlot variant="bottom" />
  </div>

  <StructuredData 
    type="SoftwareApplication" 
    data={{
      name: title,
      description: description,
      category: category
    }} 
  />
</Layout>
