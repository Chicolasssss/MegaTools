---
import { getCollection } from 'astro:content';
import * as Icons from 'lucide-react';

export interface Props {
  currentToolId: string;
  category: string;
}

const { currentToolId, category } = Astro.props;

const allTools = await getCollection('tools');
// Filter tools by the same category, excluding the current tool.
// Limit to 4 tools.
const relatedTools = allTools
  .filter(tool => tool.data.category === category && tool.id !== currentToolId)
  .slice(0, 4);

if (relatedTools.length === 0) {
  // If no tools in the same category, just show some random tools.
  allTools.filter(tool => tool.id !== currentToolId).slice(0, 4).forEach(t => relatedTools.push(t));
}
---

<div class="mt-16">
  <h3 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white">Related Tools</h3>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {relatedTools.map((tool) => {
      const IconComponent = Icons[tool.data.icon as keyof typeof Icons] as any;
      return (
        <a href={`/tools/${tool.id}`} class="group relative flex flex-col p-5 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 overflow-hidden">
					<div class="absolute inset-0 bg-gradient-to-br from-blue-50/50 to-transparent dark:from-blue-900/10 dark:to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
					<div class="relative z-10 flex flex-col h-full">
						<div class="flex items-center gap-3 mb-3">
							<div class="w-10 h-10 bg-gray-50 dark:bg-gray-800 text-blue-600 dark:text-blue-400 rounded-lg flex items-center justify-center group-hover:scale-110 group-hover:bg-blue-100 dark:group-hover:bg-blue-900/40 transition-transform duration-300 border border-gray-100 dark:border-gray-700 group-hover:border-blue-200 dark:group-hover:border-blue-800/50">
								{IconComponent && <IconComponent size={20} strokeWidth={1.5} />}
							</div>
							<h4 class="font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{tool.data.name}</h4>
						</div>
						<p class="text-gray-600 dark:text-gray-400 text-xs flex-grow mb-4 leading-relaxed line-clamp-2">{tool.data.description}</p>
						
						<div class="pt-3 border-t border-gray-100 dark:border-gray-800 flex justify-end items-center mt-auto">
							<span class="text-blue-600 dark:text-blue-400 font-semibold text-xs flex items-center gap-1 group-hover:translate-x-1 transition-transform">
								Open <Icons.ArrowRight size={14} />
							</span>
						</div>
					</div>
				</a>
      )
    })}
  </div>
</div>
