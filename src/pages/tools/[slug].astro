---
import { getCollection, render } from 'astro:content';
import ToolLayout from '../../layouts/ToolLayout.astro';

// Tool Components
import PasswordGenerator from '../../components/tools/PasswordGenerator';
import UTMBuilder from '../../components/tools/UTMBuilder';
import TextFormatter from '../../components/tools/TextFormatter';
import WordCounter from '../../components/tools/WordCounter';
import QRGenerator from '../../components/tools/QRGenerator';
import JSONFormatter from '../../components/tools/JSONFormatter';
import Base64Encoder from '../../components/tools/Base64Encoder';
import UUIDGenerator from '../../components/tools/UUIDGenerator';
import HashGenerator from '../../components/tools/HashGenerator';
import LoremIpsum from '../../components/tools/LoremIpsum';
import ColorConverter from '../../components/tools/ColorConverter';
import ImageCompressor from '../../components/tools/ImageCompressor';
import UrlEncoder from '../../components/tools/UrlEncoder';
import SlugGenerator from '../../components/tools/SlugGenerator';
import TimestampConverter from '../../components/tools/TimestampConverter';
import CidrCalculator from '../../components/tools/CidrCalculator';
import HttpStatusLookup from '../../components/tools/HttpStatusLookup';

export async function getStaticPaths() {
  const toolEntries = await getCollection('tools');
  return toolEntries.map(entry => ({
    params: { slug: entry.id }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ToolLayout 
	title={entry.data.seoTitle || entry.data.name} 
	description={entry.data.metaDescription || entry.data.description}
	category={entry.data.category}
	slug={entry.id}
>
	<Fragment slot="tool">
		{entry.id === 'password-generator' && <PasswordGenerator client:load />}
		{entry.id === 'utm-builder' && <UTMBuilder client:load />}
		{entry.id === 'text-formatter' && <TextFormatter client:load />}
		{entry.id === 'word-counter' && <WordCounter client:load />}
		{entry.id === 'qr-generator' && <QRGenerator client:load />}
		{entry.id === 'json-formatter' && <JSONFormatter client:load />}
		{entry.id === 'base64-encoder' && <Base64Encoder client:load />}
		{entry.id === 'uuid-generator' && <UUIDGenerator client:load />}
		{entry.id === 'hash-generator' && <HashGenerator client:load />}
		{entry.id === 'lorem-ipsum' && <LoremIpsum client:load />}
		{entry.id === 'color-converter' && <ColorConverter client:load />}
		{entry.id === 'image-compressor' && <ImageCompressor client:load />}
		{entry.id === 'url-encoder' && <UrlEncoder client:load />}
		{entry.id === 'slug-generator' && <SlugGenerator client:load />}
		{entry.id === 'timestamp-converter' && <TimestampConverter client:load />}
		{entry.id === 'cidr-calculator' && <CidrCalculator client:load />}
		{entry.id === 'http-status-lookup' && <HttpStatusLookup client:load />}
	</Fragment>

	<Fragment slot="content">
		<Content />
	</Fragment>
</ToolLayout>
