---
import Layout from '../../layouts/Layout.astro';
import tools from '../../data/tools.json';
import PasswordGenerator from '../../components/tools/PasswordGenerator';
import UTMBuilder from '../../components/tools/UTMBuilder';
import TextFormatter from '../../components/tools/TextFormatter';
import WordCounter from '../../components/tools/WordCounter';

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
---

<Layout 
	title={tool.name} 
	description={tool.description}
>
	<div class="max-w-4xl mx-auto">
		<!-- Breadcrumbs -->
		<nav class="flex text-sm text-gray-500 mb-8" aria-label="Breadcrumb">
		  <ol class="inline-flex items-center space-x-1 md:space-x-3">
		    <li class="inline-flex items-center">
		      <a href="/" class="hover:text-blue-600">Home</a>
		    </li>
		    <li>
		      <div class="flex items-center">
		        <span class="mx-2 text-gray-300">/</span>
		        <span class="text-gray-400">{tool.category}</span>
		      </div>
		    </li>
		    <li aria-current="page">
		      <div class="flex items-center">
		        <span class="mx-2 text-gray-300">/</span>
		        <span class="text-gray-900 dark:text-white font-medium">{tool.name}</span>
		      </div>
		    </li>
		  </ol>
		</nav>

		<!-- Tool Header (SEO H1) -->
		<div class="text-center mb-10">
			<h1 class="text-3xl md:text-5xl font-extrabold mb-4 tracking-tight">{tool.name}</h1>
			<p class="text-lg text-gray-600 dark:text-gray-400">{tool.description}</p>
		</div>

		<!-- Interactive Tool (React Island) -->
		<div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl p-6 md:p-10 shadow-sm mb-16">
			{tool.id === 'password-generator' && <PasswordGenerator client:load />}
			{tool.id === 'utm-builder' && <UTMBuilder client:load />}
			{tool.id === 'text-formatter' && <TextFormatter client:load />}
			{tool.id === 'word-counter' && <WordCounter client:load />}
			{!['password-generator', 'utm-builder', 'text-formatter', 'word-counter'].includes(tool.id) && (
				<div class="text-center py-12">
					<p class="text-gray-500 font-medium">This tool is currently under development.</p>
					<a href="/" class="text-blue-600 hover:underline mt-2 inline-block">Return Home</a>
				</div>
			)}
		</div>

		<!-- AdSense Banner -->
		<div class="w-full h-24 bg-gray-100 dark:bg-gray-900 border border-dashed border-gray-300 dark:border-gray-700 rounded-xl flex items-center justify-center mb-16 shadow-inner">
			<span class="text-gray-400 text-sm font-medium tracking-wide">Advertisement Space (Horizontal)</span>
		</div>

		<!-- SEO Article Content -->
		<article class="prose prose-gray dark:prose-invert max-w-none prose-headings:font-bold prose-a:text-blue-600 mt-12">
			<h2>What is {tool.name}?</h2>
			<p>This tool allows you to {tool.description.toLowerCase()} quickly, securely, and completely free right from your browser. You don't need to install any software or register an account to use it.</p>
			
			<h3>How to use this tool?</h3>
			<p>Using this tool is extremely simple. Just follow the instructions in the interactive panel above. All processes are performed locally on your device or via secure endpoints to guarantee maximum privacy.</p>

			<h3>Main Features</h3>
			<ul>
				<li><strong>Fast and Free:</strong> No usage limits or hidden subscriptions.</li>
				<li><strong>Privacy First:</strong> We don't store your sensitive data.</li>
				<li><strong>Easy to Use:</strong> Clean, modern, and intuitive interface.</li>
			</ul>
		</article>
	</div>
</Layout>
