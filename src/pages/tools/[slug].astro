---
import Layout from '../../layouts/Layout.astro';
import tools from '../../data/tools.json';
import PasswordGenerator from '../../components/tools/PasswordGenerator';
import UTMBuilder from '../../components/tools/UTMBuilder';
import TextFormatter from '../../components/tools/TextFormatter';

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
---

<Layout 
	title={tool.name} 
	description={tool.description}
>
	<div class="max-w-4xl mx-auto">
		<!-- Breadcrumbs -->
		<nav class="flex text-sm text-slate-500 mb-8" aria-label="Breadcrumb">
		  <ol class="inline-flex items-center space-x-1 md:space-x-3">
		    <li class="inline-flex items-center">
		      <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400">Inicio</a>
		    </li>
		    <li>
		      <div class="flex items-center">
		        <span class="mx-2">/</span>
		        <span class="text-slate-400">{tool.category}</span>
		      </div>
		    </li>
		    <li aria-current="page">
		      <div class="flex items-center">
		        <span class="mx-2">/</span>
		        <span class="text-slate-900 dark:text-white font-medium">{tool.name}</span>
		      </div>
		    </li>
		  </ol>
		</nav>

		<!-- Tool Header (SEO H1) -->
		<div class="text-center mb-10">
			<h1 class="text-4xl md:text-5xl font-extrabold mb-4">{tool.name}</h1>
			<p class="text-xl text-slate-600 dark:text-slate-400">{tool.description}</p>
		</div>

		<!-- Interactive Tool (React Island) -->
		<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 md:p-10 shadow-xl mb-16">
			{tool.id === 'password-generator' && <PasswordGenerator client:load />}
			{tool.id === 'utm-builder' && <UTMBuilder client:load />}
			{tool.id === 'text-formatter' && <TextFormatter client:load />}
			{!['password-generator', 'utm-builder', 'text-formatter'].includes(tool.id) && <p>Herramienta en desarrollo...</p>}
		</div>

		<!-- AdSense Banner -->
		<div class="w-full h-24 bg-slate-100 dark:bg-slate-800/50 border border-dashed border-slate-300 dark:border-slate-700 rounded-xl flex items-center justify-center mb-16">
			<span class="text-slate-400 text-sm">Espacio para Banner AdSense Horizontal</span>
		</div>

		<!-- SEO Article Content -->
		<article class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-bold prose-a:text-blue-600 dark:prose-a:text-blue-400">
			<h2>¿Qué es el {tool.name}?</h2>
			<p>Esta herramienta te permite {tool.description.toLowerCase()} de forma rápida, segura y completamente gratuita desde tu navegador. No necesitas instalar nada ni registrarte para utilizarla.</p>
			
			<h3>¿Cómo utilizar esta herramienta?</h3>
			<p>El uso es extremadamente sencillo. Simplemente sigue las instrucciones que aparecen en el panel interactivo superior. Todos los procesos se realizan en tu propio dispositivo para garantizar la máxima privacidad.</p>

			<h3>Beneficios principales</h3>
			<ul>
				<li><strong>Rápido y gratis:</strong> Sin límites de uso ni suscripciones.</li>
				<li><strong>Privacidad garantizada:</strong> No almacenamos tu información.</li>
				<li><strong>Fácil de usar:</strong> Interfaz intuitiva y moderna.</li>
			</ul>
		</article>
	</div>
</Layout>
