---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout 
	title="Blog & Resources" 
	description="Read our latest guides, tutorials, and insights on web utilities, SEO, and productivity."
>
	<div class="max-w-5xl mx-auto">
		<div class="text-center mb-16">
			<h1 class="text-4xl md:text-5xl font-extrabold mb-4 tracking-tight text-gray-900 dark:text-white">Our Blog</h1>
			<p class="text-xl text-gray-600 dark:text-gray-400">Insights, guides, and tips for maximum productivity.</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
			{sortedPosts.map((post) => (
				<a href={`/blog/${post.id}`} class="group flex flex-col p-8 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm hover:shadow-md hover:border-blue-500 dark:hover:border-blue-500 transition-all duration-200">
					<div class="flex items-center gap-2 mb-4">
						{post.data.tags.map((tag) => (
							<span class="px-3 py-1 bg-gray-100 dark:bg-gray-800 text-xs font-semibold text-gray-600 dark:text-gray-400 rounded-full uppercase tracking-wider">{tag}</span>
						))}
					</div>
					<h2 class="text-2xl font-bold mb-3 text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
						{post.data.title}
					</h2>
					<p class="text-gray-600 dark:text-gray-400 mb-6 flex-grow">
						{post.data.description}
					</p>
					<div class="flex justify-between items-center text-sm font-medium text-gray-500 dark:text-gray-400">
						<span>{post.data.author}</span>
						<span>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
					</div>
				</a>
			))}
		</div>

		<!-- AdSense Banner -->
		<div class="w-full h-24 bg-gray-100 dark:bg-gray-900 border border-dashed border-gray-300 dark:border-gray-700 rounded-xl flex items-center justify-center mt-16 shadow-inner">
			<span class="text-gray-400 text-sm font-medium tracking-wide">Advertisement Space (Horizontal)</span>
		</div>
	</div>
</Layout>
