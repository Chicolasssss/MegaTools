---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SearchIsland } from '../components/SearchIsland';
import AdSlot from '../components/ads/AdSlot.astro';
import * as Icons from 'lucide-react';

const toolsCollection = await getCollection('tools');
const categories = await getCollection('categories');
const guidesCollection = await getCollection('guides');

const toolsPayload = toolsCollection.map(tool => ({
  id: tool.id,
  name: tool.data.name,
  description: tool.data.description,
  category: tool.data.category,
  icon: tool.data.icon,
  slug: tool.id,
  type: 'tool' as const
}));

const guidesPayload = guidesCollection.map(g => ({
  id: `guide-${g.id}`,
  name: g.data.title,
  description: g.data.description,
  category: g.data.category,
  slug: g.id,
  type: 'guide' as const
}));

const references = [
    { title: "HTTP Status Codes", url: "/tools/http-status-lookup", desc: "Lookup HTTP codes" },
    { title: "Network Ports", url: "/references/network-ports", desc: "Database of standard ports" },
    { title: "MIME Types", url: "/references/mime-types", desc: "Lookup file extensions" }
];

const referencesPayload = references.map((r, i) => ({
  id: `ref-${i}`,
  name: r.title,
  description: r.desc,
  category: 'Reference',
  url: r.url,
  type: 'reference' as const
}));

const searchPayload = [...toolsPayload, ...guidesPayload, ...referencesPayload];
---

<Layout 
	title="Home" 
	description="MegaTools Hub - All the web utilities you need in one single place."
>
	<!-- Hero Section -->
	<section class="py-20 flex flex-col items-center justify-center text-center">
		<h1 class="text-5xl md:text-6xl font-extrabold tracking-tight mb-6 text-gray-900 dark:text-white">
			Your professional tools,<br/>
			<span class="text-blue-600">all in one place.</span>
		</h1>
		<p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 mb-10 max-w-2xl">
			Fast, free, and secure. Find the perfect utility for your daily workflow. No sign-ups required.
		</p>
		
		<div class="w-full max-w-3xl relative">
			<SearchIsland client:load tools={searchPayload} />
		</div>
	</section>

	<!-- AdSense Banner -->
	<AdSlot variant="content" />

	<!-- Categories Grid -->
	<section id="categories" class="mb-20">
		<h2 class="text-2xl font-bold mb-8 text-gray-900 dark:text-white">Browse by Category</h2>
		<div class="flex flex-wrap gap-4">
			{categories.map((category) => (
				<a href={`/category/${category.id}`} class="px-6 py-4 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm hover:shadow-md hover:border-blue-500 transition-all font-semibold text-gray-800 dark:text-gray-200">
					{category.data.name}
				</a>
			))}
		</div>
	</section>

	<!-- Tools Grid -->
	<section id="tools" class="mb-24">
		<h2 class="text-2xl font-bold mb-8 text-gray-900 dark:text-white">Popular Tools</h2>
		
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
			{toolsPayload.map((tool) => {
				const IconComponent = Icons[tool.icon as keyof typeof Icons] as any;
				
				return (
				<a href={`/tools/${tool.slug}`} class="group flex flex-col p-6 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm hover:shadow-md hover:border-blue-500 dark:hover:border-blue-500 transition-all duration-200">
					<div class="w-12 h-12 bg-gray-50 dark:bg-gray-800 text-blue-600 dark:text-blue-400 rounded-lg flex items-center justify-center mb-5 group-hover:bg-blue-50 dark:group-hover:bg-blue-900/20 transition-colors">
						{IconComponent && <IconComponent size={24} strokeWidth={1.5} />}
					</div>
					<h3 class="text-lg font-bold mb-2 text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{tool.name}</h3>
					<p class="text-gray-600 dark:text-gray-400 text-sm flex-grow mb-4 leading-relaxed">{tool.description}</p>
					
					<div class="pt-4 border-t border-gray-100 dark:border-gray-800 flex justify-between items-center text-xs font-semibold uppercase tracking-wider">
						<span class="text-gray-400">{tool.category}</span>
						<span class="text-blue-600 dark:text-blue-400 group-hover:translate-x-1 transition-transform">Use Tool &rarr;</span>
					</div>
				</a>
			)})}
		</div>
	</section>
</Layout>
