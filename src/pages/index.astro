---
import Layout from '../layouts/Layout.astro';
import tools from '../data/tools.json';

// We could add a React search component here, but for now we'll do static Astro
// or a simple React island for real-time search. Let's build a React island.
import { SearchIsland } from '../components/SearchIsland';
---

<Layout 
	title="Inicio" 
	description="MegaTools Hub - Todas las mini-herramientas que necesitas en un solo lugar."
>
	<!-- Hero Section -->
	<section class="py-20 flex flex-col items-center justify-center text-center">
		<h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6">
			Tus herramientas <span class="bg-gradient-to-r from-blue-600 to-indigo-500 text-transparent bg-clip-text">en un solo lugar</span>
		</h1>
		<p class="text-lg md:text-xl text-slate-600 dark:text-slate-400 mb-10 max-w-2xl">
			Rápido, gratis y sin complicaciones. Encuentra la herramienta perfecta para tu trabajo diario.
		</p>
		
		<div class="w-full max-w-2xl relative">
			<SearchIsland client:load tools={tools} />
		</div>
	</section>

	<!-- AdSense Banner -->
	<div class="w-full h-24 bg-slate-100 dark:bg-slate-800/50 border border-dashed border-slate-300 dark:border-slate-700 rounded-xl flex items-center justify-center mb-16">
		<span class="text-slate-400 text-sm">Espacio para Banner AdSense (728x90)</span>
	</div>

	<!-- Tools Grid -->
	<section id="categorias" class="mb-20">
		<h2 class="text-3xl font-bold mb-8">Todas las herramientas</h2>
		
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
			{tools.map((tool) => (
				<a href={`/tools/${tool.slug}`} class="group flex flex-col p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm hover:shadow-md hover:border-blue-500 dark:hover:border-blue-500 transition-all">
					<div class="w-12 h-12 bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
						{/* Fallback Icon if lucide is not dynamically rendering on server */}
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							{tool.icon === 'Key' && <path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 0 0-1.4L19 4"/> <path d="m21 2-9.6 9.6"/><circle cx="7.5" cy="15.5" r="5.5"/>}
							{tool.icon === 'Link' && <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>}
							{tool.icon === 'Type' && <polyline points="4 7 4 4 20 4 20 7"/><line x1="9" x2="15" y1="20" y2="20"/><line x1="12" x2="12" y1="4" y2="20"/>}
							{tool.icon === 'FileText' && <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>}
						</svg>
					</div>
					<h3 class="text-xl font-bold mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{tool.name}</h3>
					<p class="text-slate-600 dark:text-slate-400 text-sm flex-grow">{tool.description}</p>
					
					<div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-800 flex justify-between items-center text-sm">
						<span class="text-slate-500">{tool.category}</span>
						<span class="text-blue-600 dark:text-blue-400 font-medium">Usar ahora &rarr;</span>
					</div>
				</a>
			))}
		</div>
	</section>
</Layout>
