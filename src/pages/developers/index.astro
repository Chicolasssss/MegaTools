---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SearchIsland } from '../../components/SearchIsland';
import * as Icons from 'lucide-react';
import AdSlot from '../../components/ads/AdSlot.astro';

// We want to fetch tools specifically related to developers
const toolsCollection = await getCollection('tools');
const devCategories = ['Developer', 'Networking', 'Security', 'Text'];
const devTools = toolsCollection.filter(tool => devCategories.includes(tool.data.category)).map(t => ({
  id: t.id,
  name: t.data.name,
  description: t.data.description,
  category: t.data.category,
  icon: t.data.icon,
  slug: t.id,
  type: 'tool' as const
}));

const references = [
    { title: "HTTP Status Codes", url: "/tools/http-status-lookup", desc: "Lookup HTTP codes" },
    { title: "Network Ports", url: "/references/network-ports", desc: "Database of standard ports" },
    { title: "MIME Types", url: "/references/mime-types", desc: "Lookup file extensions" }
];

const guidesCollection = await getCollection('guides');
const guidesPayload = guidesCollection.map(g => ({
  id: `guide-${g.id}`,
  name: g.data.title,
  description: g.data.description,
  category: g.data.category,
  slug: g.id,
  type: 'guide' as const
}));

const referencesPayload = references.map((r, i) => ({
  id: `ref-${i}`,
  name: r.title,
  description: r.desc,
  category: 'Reference',
  url: r.url,
  type: 'reference' as const
}));

const searchPayload = [...devTools, ...guidesPayload, ...referencesPayload];
---

<Layout 
	title="Developer & Networking Hub" 
	description="Fast, private online tools for developers, network engineers, and IT professionals."
>
	<div class="max-w-6xl mx-auto">
        <header class="py-16 text-center">
            <h1 class="text-5xl md:text-6xl font-extrabold mb-6 tracking-tight text-gray-900 dark:text-white">Developer Hub</h1>
            <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto mb-10">
                Fast, private online tools for developers, network engineers and IT professionals. 100% Client-side.
            </p>
            
            <div class="max-w-2xl mx-auto relative mb-12">
                <SearchIsland client:load tools={searchPayload} />
            </div>

            <div class="flex flex-wrap justify-center gap-3">
                <a href="/category/developer" class="px-5 py-2.5 bg-gray-100 dark:bg-gray-800 hover:bg-blue-50 dark:hover:bg-blue-900/30 text-gray-800 dark:text-gray-200 hover:text-blue-600 dark:hover:text-blue-400 rounded-full font-medium transition-colors border border-gray-200 dark:border-gray-700">Programming</a>
                <a href="/category/networking" class="px-5 py-2.5 bg-gray-100 dark:bg-gray-800 hover:bg-blue-50 dark:hover:bg-blue-900/30 text-gray-800 dark:text-gray-200 hover:text-blue-600 dark:hover:text-blue-400 rounded-full font-medium transition-colors border border-gray-200 dark:border-gray-700">Networking</a>
                <a href="/category/security" class="px-5 py-2.5 bg-gray-100 dark:bg-gray-800 hover:bg-blue-50 dark:hover:bg-blue-900/30 text-gray-800 dark:text-gray-200 hover:text-blue-600 dark:hover:text-blue-400 rounded-full font-medium transition-colors border border-gray-200 dark:border-gray-700">Security</a>
                <a href="/guides" class="px-5 py-2.5 bg-gray-100 dark:bg-gray-800 hover:bg-blue-50 dark:hover:bg-blue-900/30 text-gray-800 dark:text-gray-200 hover:text-blue-600 dark:hover:text-blue-400 rounded-full font-medium transition-colors border border-gray-200 dark:border-gray-700">Guides</a>
            </div>
        </header>

        <AdSlot variant="content" />

        <!-- Reference Tables -->
        <section class="mb-20">
            <h2 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white">Developer References</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {references.map(ref => (
                    <a href={ref.url} class="p-6 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl hover:border-blue-500 transition-colors shadow-sm">
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">{ref.title}</h3>
                        <p class="text-gray-600 dark:text-gray-400 text-sm">{ref.desc}</p>
                    </a>
                ))}
            </div>
        </section>

        <section class="mb-20">
            <h2 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white">Popular Utilities</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                {devTools.map((tool) => {
                const IconComponent = Icons[tool.icon as keyof typeof Icons] as any;
                return (
				<a href={`/tools/${tool.slug}`} class="group relative flex flex-col p-6 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
					<div class="absolute inset-0 bg-gradient-to-br from-blue-50/50 to-transparent dark:from-blue-900/10 dark:to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
					<div class="relative z-10 flex flex-col h-full">
						<div class="w-14 h-14 bg-gray-50 dark:bg-gray-800 text-blue-600 dark:text-blue-400 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-blue-100 dark:group-hover:bg-blue-900/40 transition-transform duration-300 border border-gray-100 dark:border-gray-700 group-hover:border-blue-200 dark:group-hover:border-blue-800/50">
							{IconComponent && <IconComponent size={28} strokeWidth={1.5} />}
						</div>
						<h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{tool.name}</h3>
						<p class="text-gray-600 dark:text-gray-400 text-sm flex-grow mb-6 leading-relaxed line-clamp-3">{tool.description}</p>
						
						<div class="pt-5 border-t border-gray-100 dark:border-gray-800 flex justify-between items-center mt-auto">
							<span class="text-[10px] font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-800 px-3 py-1 rounded-full">{tool.category}</span>
							<span class="text-blue-600 dark:text-blue-400 font-semibold text-sm flex items-center gap-1 group-hover:translate-x-1 transition-transform">
								Open <Icons.ArrowRight size={16} />
							</span>
						</div>
					</div>
				</a>
                )
                })}
            </div>
        </section>
    </div>
</Layout>
