---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Contact Us" description="Get in touch with MegaTools Hub">
	<div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
		<h1 class="text-4xl font-extrabold text-gray-900 dark:text-white mb-8">Contact Us</h1>
		<div class="prose prose-lg dark:prose-invert">
			<p>Have a suggestion for a new tool? Found a bug? Want to advertise on MegaTools Hub?</p>
			
            <div class="bg-gray-50 dark:bg-gray-800/50 p-6 rounded-lg border border-gray-200 dark:border-gray-700 not-prose mt-8">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Email</h3>
                <p class="text-gray-600 dark:text-gray-400 mb-2">For general inquiries and support:</p>
                <a href="mailto:[INSERT_EMAIL_HERE]" class="text-blue-600 dark:text-blue-400 font-medium hover:underline">[INSERT_EMAIL_HERE]</a>
            </div>
		</div>
	</div>
</Layout>
